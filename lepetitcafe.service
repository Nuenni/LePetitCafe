[Unit]
Description=LePetitCafe receipt printer
# Deliberately NOT network-online.target: for USB printers, waiting on WiFi
# costs 15-30 seconds of boot time for no reason. If the printer is on the
# network after all, main.py retries a few times at startup (_auf_drucker_warten).
After=multi-user.target

[Service]
Type=simple
User=pi
# Access to /dev/usb/lp0 (root:lp) and /dev/ttyUSB0 (root:dialout)
SupplementaryGroups=lp dialout
WorkingDirectory=/home/pi/LePetitCafe
ExecStart=/usr/bin/python3 /home/pi/LePetitCafe/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
