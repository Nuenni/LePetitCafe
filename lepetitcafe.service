[Unit]
Description=LePetitCafe Kassenbon-Drucker
# Bewusst KEIN network-online.target: Bei USB-Druckern kostet das Warten auf
# WLAN 15-30 Sekunden Bootzeit, ohne dass es gebraucht wird. Falls der Drucker
# doch im Netz hängt, fasst main.py beim Start mehrfach nach (_auf_drucker_warten).
After=multi-user.target

[Service]
Type=simple
User=pi
# Zugriff auf /dev/usb/lp0 (gehört root:lp)
SupplementaryGroups=lp
WorkingDirectory=/home/pi/LePetitCafe
ExecStart=/usr/bin/python3 /home/pi/LePetitCafe/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
