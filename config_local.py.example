# Personal overrides - template
#
# Copy and rename:
#     cp config_local.py.example config_local.py
#
# config_local.py is listed in .gitignore, so it never ends up in the
# repository. Everything that's nobody else's business goes here: real
# names, your printer's IP, WiFi details.
#
# Anything set here overrides the defaults from config.py.
# Leaving something out is fine - whatever's missing keeps its default.


# Kids' names, used as cashier and server on the receipts
STAFF_NAMES = ["Name1", "Name2", "Name3"]

# First names for table reservations. If the randomly rolled party size
# matches (or is smaller than) the number of names here, the receipt lists
# them by name ("For: Name1 & Name2") instead of just printing "The
# <lastname> Family". For bigger groups (birthdays etc.) the generic last
# name from config.GUEST_NAMES kicks in automatically.
GUEST_FIRST_NAMES = ["Name1", "Name2", "Name3"]

# Receipt language: "de" or "en"
LANGUAGE = "de"

# If the printer is on the network instead of connected via USB cable
# PRINTER_MODE = "network"
# PRINTER_IP   = "192.168.1.42"
